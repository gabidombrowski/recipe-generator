# Without this file, `COPY . .` in the build stage copies the host's
# node_modules over the ones compiled inside the image — and better-sqlite3's
# native addon, built for the host's OS and architecture, fails at runtime with
# "invalid ELF header". It also keeps the build context small enough to send
# quickly.

node_modules
.next
out
dist

# Never belongs in an image.
.env
.env.*
!.env.example
seed.local.json
nutrition-context.md
data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Terraform state carries the tunnel secret.
infra/.terraform
infra/terraform.tfstate*
infra/*.tfvars
!infra/*.tfvars.example

# Test and tooling output.
coverage
test-results
playwright-report
blob-report
tests/e2e/.auth
evals/reports
.cache
models

.git
.github
.claude
*.tsbuildinfo
.DS_Store
npm-debug.log*
