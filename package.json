{
  "name": "recipe-generator",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "evals": "vitest run --project evals",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "embeddings:backfill": "tsx src/server/embeddings/backfill.ts",
    "evals:metrics": "tsx evals/report-to-prometheus.ts",
    "pack": "node scripts/pack-standalone.mjs",
    "build:standalone": "next build && node scripts/pack-standalone.mjs",
    "dev:session": "node scripts/dev-session.mjs",
    "dev:signed-in": "node scripts/dev-signed-in.mjs",
    "build:demo": "next build demo",
    "record-demo-fixtures": "node scripts/record-demo-fixtures.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@huggingface/transformers": "^3.8.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.7.1",
    "@trpc/server": "^11.7.1",
    "@trpc/tanstack-react-query": "^11.7.1",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.29",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sqlite-vec": "^0.1.7-alpha.2",
    "superjson": "^2.2.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@storybook/nextjs": "^10.5.7",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.2.1",
    "pino-pretty": "^13.1.2",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.0"
  }
}
