# Copy to .env and fill in. Never commit .env — it is gitignored.
# Names only here; no values, no hostnames, no identities.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Absolute path to the SQLite file on persistent storage.
# Local dev: ./data/nutrition.db   Server: a path inside the persistent volume.
DB_PATH=

# IANA timezone for the process. Should match Settings.timezone.
TZ=

# ---------------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app credentials.
# Callback URL: https://<your-host>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The single email address permitted to sign in. Every other identity is
# rejected in the signIn callback. This app is single-user by design.
# GitHub numeric account id(s), comma separated. Not the username and not an
# email: GitHub withholds the address of an account with a private one, and
# usernames can be changed and then re-registered by someone else.
#   curl -s https://api.github.com/users/<username> | jq .id
ALLOWED_GITHUB_ID=

# Public origin, used by Auth.js to build callback URLs behind a proxy/tunnel.
AUTH_URL=

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------

# Optional. Without it, AI recipe generation and agentic planner mode are
# disabled and the scheduler runs in deterministic mode only.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Port for the OpenTelemetry Prometheus exporter. Bind to the private/container
# network only — never expose this publicly.
METRICS_PORT=9464
METRICS_HOST=127.0.0.1

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
